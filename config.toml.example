# Copy to ~/.config/argus/config.toml
# Env vars: PROXMOX_HOST, PROXMOX_TOKEN_ID, PROXMOX_SECRET, PROXMOX_USERNAME, PROXMOX_PASSWORD
#           ARGUS_SSH_USER, ARGUS_SSH_KEY, ARGUS_DOMAIN, ARGUS_TIMEZONE
#           SALT_URL, SALT_USERNAME, SALT_PASSWORD
#           NOMAD_URL, NOMAD_TOKEN
#           PROMETHEUS_URL, PROMETHEUS_TOKEN, ARGUS_METRICS_LISTEN
#           TECHNITIUM_URL, TECHNITIUM_TOKEN
#           STEPCA_URL
#           TRUENAS_URL, TRUENAS_API_KEY
#
# Secrets should be stored in the macOS Keychain via the Keys screen (tab: Keys).
# Config file values act as fallback only; keychain entries always take priority.

# Proxmox — required. Two auth modes:
#   Token auth (recommended): set token_id + secret
#   Ticket auth: set username + password (e.g. "root@pam"); takes priority over token
host     = "https://pve.yourdomain.com:8006"
token_id = "user@pam!argus"   # Datacenter > Permissions > API Tokens
secret   = ""                    # leave empty — store in Keychain via Keys screen
username = ""                    # e.g. "root@pam" for ticket auth instead of token
password = ""                    # leave empty — store in Keychain (key: proxmox_password)
insecure = false                 # set true only for a self-signed cert you cannot trust

# Global defaults — applied across all integrations
# These propagate to sub-sections if those fields are not already set.
# Env vars: ARGUS_SSH_USER, ARGUS_SSH_KEY, ARGUS_DOMAIN, ARGUS_TIMEZONE
[globals]
ssh_user    = "admin"        # default SSH username for all node connections
ssh_key     = ""             # path to SSH private key (leave empty to use ssh-agent)
domain      = ""             # homelab domain suffix, e.g. "homelab.local"
timezone    = "UTC"          # IANA timezone for log display (e.g. "America/New_York")
admin_email = ""             # operator email for cert SANs / notifications

# Platform bootstrap — optional; `argus bootstrap` uses these defaults.
[bootstrap]
ssh_user       = "root"      # SSH user on the Proxmox host (root is required for first bootstrap)
ssh_key        = ""          # falls back to [globals] ssh_key / ssh-agent
salt_master_id = ""          # minion ID for the Proxmox host (default: node name)
salt_api_url   = ""          # default: https://<proxmox-host>:8000
salt_api_user  = "saltapi"   # PAM user for salt-api

# Salt — optional; omit to disable the minions screen (m)
# master_minion: the minion ID of your salt-master host (usually its hostname).
# Required for 'w' (service wiring) in the Services screen — argus writes pillar
# files to the master by running cmd.run on this minion.
# Add to /srv/pillar/top.sls: base: '<master_minion>': [argus_services]
[salt]
url           = "https://salt.yourdomain.com:8000"
username      = "saltapi"
password      = ""              # prefer the Keychain (salt_password) or SALT_PASSWORD
eauth         = "pam"           # pam (default), ldap, file
insecure      = false           # set true only for a self-signed salt-api cert
master_minion = "salt-master"   # minion ID of the salt-master host; required for service wiring
pillar_base   = "/srv/pillar"   # default; only set if your master uses a non-standard path
state_base    = "/srv/salt"     # default; only set if your master uses a non-standard path

# Nomad — optional; omit to disable the jobs screen (n)
[nomad]
url   = "http://nomad.yourdomain.com:4646"
token = ""  # ACL token; leave empty if ACLs are disabled

# Defaults applied when provisioning new VMs (c key on guest list)
# ssh_user inherits from [globals] if left empty.
# SSH passwords are stored in the macOS Keychain via the Keys screen.
[defaults]
template_id   = 9000
cpu_cores     = 2
memory_mb     = 2048
disk_gb       = 20
storage       = "local-lvm"
bridge        = "vmbr0"
ostype        = "l26"
ssh_user      = ""          # inherits globals.ssh_user ("admin") — override here if needed
ci_user       = "ubuntu"
ci_ssh_key    = ""          # paste your public key here
ci_ipconfig   = "ip=dhcp"
nameserver    = "1.1.1.1"
searchdomain  = ""          # inherits globals.domain if set
backup_storage = ""         # Proxmox storage ID for listing backups in guest detail (e.g. "pbs", "local")

# Matchbox PXE server — optional; enables the PXE screen for bare-metal provisioning
# Run Matchbox as a Nomad job or Docker container: https://matchbox.psdn.io
# Env vars: MATCHBOX_URL, MATCHBOX_TOKEN
[matchbox]
url   = "http://matchbox.yourdomain.com:8080"
token = ""  # optional Bearer token if Matchbox is behind an auth proxy

# CrowdSec — optional; enables the Security → CrowdSec tab
# Get LAPI key: cscli bouncers add argus
# Env vars: CROWDSEC_URL, CROWDSEC_API_KEY
[crowdsec]
url     = "http://localhost:8080"  # CrowdSec Local API address
api_key = ""                       # from: cscli bouncers add argus

# TrueNAS — optional; enables the Services → TrueNAS tab
# Monitors ZFS pools, datasets, alerts, and running services.
# API key: TrueNAS UI → System → API Keys → Add (grant all permissions)
# Env vars: TRUENAS_URL, TRUENAS_API_KEY
[truenas]
url      = "https://truenas.yourdomain.com"
api_key  = ""      # store in Keychain via Keys screen
insecure = false   # set true only for a self-signed cert you cannot trust

# Wazuh — optional; enables the Security → Wazuh tab
# Env vars: WAZUH_URL, WAZUH_USERNAME, WAZUH_PASSWORD
[wazuh]
url      = "https://wazuh-manager.yourdomain.com:55000"
username = "wazuh-wui"
password = ""
# Wazuh often uses a self-signed certificate. Verification is on by default;
# set this to true only if you cannot install its CA.
# insecure = false

# Claude AI — optional; enables AI-powered VM resize explanations (? key in right-sizing screen)
# Env var: ANTHROPIC_API_KEY (preferred; avoids storing key in config file)
[claude]
api_key = ""  # or set ANTHROPIC_API_KEY env var
model   = ""  # leave empty for default (claude-sonnet-4-6)

# Technitium DNS — optional; enables the DNS tab in the Services screen
# Get your API token: Technitium admin → Settings → API Keys
# Env vars: TECHNITIUM_URL, TECHNITIUM_TOKEN
[technitium]
url   = "http://dns.yourdomain.com:5380"
token = ""  # API token from Technitium admin panel

# Smallstep step-ca — optional; enables CA health check in Services screen
# fingerprint: run `step ca fingerprint` on the CA host
# Env var: STEPCA_URL
[stepca]
url         = "https://ca.yourdomain.com:8443"
fingerprint = ""  # SHA-256 fingerprint of the root cert (from `step ca fingerprint`)

# Home Assistant — optional; enables the Home Assistant tab in the Services screen
# and exposes HA entities/services via the MCP server (for Hermes).
# Long-lived token: HA UI → Profile → Long-lived access tokens → Create token
# Env vars: none (set in config or Keychain via Keys screen, key: homeassistant_token)
[homeassistant]
url      = "http://homeassistant.local:8123"
token    = ""      # store in Keychain via Keys screen
insecure = false

# Loki — optional; enables the Loki tab in the Metrics screen for log browsing
# LogQL queries: https://grafana.com/docs/loki/latest/query/
# Env vars: none (set in config or Keychain)
[loki]
url      = "http://loki.yourdomain.com:3100"
token    = ""       # Bearer token if Loki is behind an auth proxy; store in Keychain via Keys screen (key: loki_token)
insecure = false

# Prometheus / Metrics — optional
# url    — Prometheus server to query in the Metrics screen (tab: Metrics)
# listen — argus's own /metrics server; scrape at http://host:9099/metrics
#          leave empty to disable. Defaults to loopback; use "0.0.0.0:9099"
#          only if a firewall or authenticated reverse proxy sits in front.
# Env vars: PROMETHEUS_URL, PROMETHEUS_TOKEN, ARGUS_METRICS_LISTEN
[prometheus]
url    = "http://prometheus.yourdomain.com:9090"
token  = ""       # Bearer token if Prometheus auth is enabled
listen = "127.0.0.1:9099"  # loopback-only by default; no auth on this endpoint

# Plex Media Server — optional; enables the Plex screen (tab: Plex)
# token: get your X-Plex-Token from https://support.plex.tv/articles/204059436
#        or store it in the Keychain via Keys screen (key: plex_token)
# vmid/vm_node: set to the Proxmox VMID/node where Plex runs for status badge
[plex]
url      = "http://192.168.1.50:32400"
token    = ""      # X-Plex-Token; store in Keychain via Keys screen
insecure = false
vmid     = 0       # optional: Proxmox VMID of the Plex VM
vm_node  = ""      # optional: Proxmox node name for the Plex VM

# Servarr companion services — each optional; omit a section to skip that service.
# api_key: Settings → General → API Key in each app's web UI
# vmid/vm_node: set if the service runs in a Proxmox VM (for status badge)

[servarr.sonarr]
url     = "http://192.168.1.50:8989"
api_key = ""
insecure = false
vmid    = 0
vm_node = ""

[servarr.radarr]
url     = "http://192.168.1.50:7878"
api_key = ""
insecure = false
vmid    = 0
vm_node = ""

[servarr.lidarr]
url     = "http://192.168.1.50:8686"
api_key = ""
insecure = false

[servarr.readarr]
url     = "http://192.168.1.50:8787"
api_key = ""
insecure = false

[servarr.prowlarr]
url     = "http://192.168.1.50:9696"
api_key = ""
insecure = false

[servarr.bazarr]
url     = "http://192.168.1.50:6767"
api_key = ""
insecure = false

[servarr.overseerr]
url     = "http://192.168.1.50:5055"
api_key = ""
insecure = false

[servarr.tautulli]
url     = "http://192.168.1.50:8181"
api_key = ""
insecure = false
